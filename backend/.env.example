# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

# Database: sqlite | pgsql | mysql (mysql also covers MariaDB).
DB_DRIVER=sqlite
# SQLite only. Relative paths resolve against the backend root.
DB_PATH=runtime/database.sqlite
# PostgreSQL / MariaDB only. DB_PORT defaults to 5432 (pgsql) or 3306 (mysql).
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=content_visual_builder
DB_USER=
DB_PASSWORD=

# Session cookie "Secure" flag. Empty = on in prod, off in dev/test.
SESSION_COOKIE_SECURE=
