  "controls": {
    "content": [
      {
        "section": "Video",
        "controls": [
          { "prop": "url", "label": "Link (YouTube, Vimeo or .mp4/.webm)" },
          { "prop": "title", "label": "Accessible Title" },
          { "prop": "autoplay", "label": "Autoplay" },
          { "prop": "muted", "label": "Mute" },
          { "prop": "loop", "label": "Loop" },
          { "prop": "controls", "label": "Player Controls" }
        ]
      }
    ],
    "style": [
      {
        "section": "Video",
        "controls": [
          { "style": "aspectRatio", "label": "Aspect Ratio" },
          { "style": "borderRadius", "label": "Border Radius" }
        ]
      }
    ]
